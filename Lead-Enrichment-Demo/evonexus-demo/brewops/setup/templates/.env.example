# BrewOps pipeline, secrets template.
# 1) Copy to ".env"        cp .env.example .env
# 2) Replace every REPLACE_ME with your real value.
# 3) Make sure ".env" is in .gitignore. NEVER commit real keys.

# --- Model (Path C requires this; Path B can use subscription login instead) ---
ANTHROPIC_API_KEY=REPLACE_ME

# --- CRM / state (self-hosted Notion MCP. Skip if you use the hosted OAuth MCP.) ---
NOTION_TOKEN=REPLACE_ME
# Your database IDs (from the DB page URL). Used by the orchestrator prompt.
NOTION_DB_SHOPS=REPLACE_ME
NOTION_DB_CONTACTS=REPLACE_ME

# --- Web search (OPTIONAL: only if you use Tavily instead of built-in WebSearch) ---
TAVILY_API_KEY=REPLACE_ME

# --- Email enrichment (OPTIONAL but recommended) ---
HUNTER_API_KEY=REPLACE_ME

# --- Inbound signal (OPTIONAL) ---
POSTHOG_API_KEY=REPLACE_ME
POSTHOG_PROJECT_ID=REPLACE_ME
